---
// Sticky FAQ
// ------------
// Description: A sticky FAQ section with a title and a subtitle
// Properties:
// - title: The title of the hero section
// - text: The subtitle of the hero section
// - classes: Additional classes to be added to the hero section

// Components
// - Layout
import SectionSticky from '../../blocks/basic/StickySidebar.astro'
// - UI
import Header from '../../ui/Header.astro'
import DecorationBorder from '../../ui/DecorationBorder.astro'

// Content
// - Props
type Props = {
	title?: string
	subtitle?: string
	classes?: string
}
const { title = '', subtitle = '', classes = '' } = Astro.props
---

<SectionSticky classes={`${classes ? classes : ''}`}>
	<Header
		title={title}
		subtitle={subtitle}
		headingLevel="h2"
		titleClasses="bg-white dark:bg-neutral-950 "
		slot="sidebar"
	/>

	<div class="faq">
		<div class="faq__item">
			<h3 class="faq__item__title">¿Cuánto tiempo toma desarrollar mi proyecto?</h3>
			<p class="faq__item__text">
				Depende del alcance: una landing page simple puede estar lista en pocas semanas, mientras
				que un e-commerce o una automatización a medida toma más tiempo. En la propuesta inicial te
				damos un plazo estimado concreto, no una promesa genérica.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">¿Trabajan con empresas fuera de Santiago?</h3>
			<p class="faq__item__text">
				Sí, trabajamos de forma remota con empresas en toda la Región Metropolitana y otras regiones
				de Chile. Toda la coordinación se hace por videollamada y canales digitales, sin necesidad de
				reuniones presenciales.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">¿Qué incluye el servicio de automatización?</h3>
			<p class="faq__item__text">
				Identificamos tareas repetitivas en tu operación (envío de correos, recordatorios,
				actualización de planillas, atención por WhatsApp) y las automatizamos con RPA e
				integraciones de IA, conectando las herramientas que ya usas.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">¿Puedo partir con un sitio web y sumar automatización después?</h3>
			<p class="faq__item__text">
				Sí. Muchos clientes empiezan con un sitio web o tienda online y más adelante suman
				automatización de procesos o consultoría a medida que su negocio crece.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">¿Qué pasa después de que el sitio queda publicado?</h3>
			<p class="faq__item__text">
				Seguimos disponibles para soporte, mantención y ajustes. No entregamos el proyecto y
				desaparecemos — el objetivo es una relación de largo plazo con tu empresa.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
	</div>
</SectionSticky>

<style>
	@reference '../../../styles/global.css';
	.faq {
		@apply flex flex-col gap-6 lg:gap-8;
	}
	.faq__item {
		@apply relative bg-white p-6 lg:p-8 dark:bg-neutral-950;
	}
	.faq__item__title {
		@apply mb-2 text-2xl leading-8;
	}
	.faq__item__text {
		@apply mb-0 text-xl leading-8;
	}
</style>