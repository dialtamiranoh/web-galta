---
// Home Page
// ------------
// Description: Landing de una sola página para Galta, navegable por anclas desde el menú.

// Components
// - Layout
import Layout from '../layouts/Layout.astro'

// - Blocks
import Hero from '../components/blocks/hero/CenteredHeroCTA.astro'
import Features from '../components/blocks/features/MasonryGrid.astro'
import Pricing from '../components/blocks/pricing/SimplePricing.astro'
import ScrollSpySteps from '../components/blocks/onboarding/Steps.astro'
import Faq from '../components/blocks/faq/StickyFaq.astro'
import CTA from '../components/blocks/cta/CTAPrimary.astro'

// Content
// - SEO
const SEO = {
	title: 'Galta | Desarrollo web, e-commerce y automatización para empresas en Chile',
	description:
		'Sitios web, tiendas online, automatización de procesos y consultoría informática. Trabajamos con empresas de banca, minería y retail en Chile.'
}
// - Hero data
const heroData = {
	title: 'Tecnología que hace crecer tu negocio',
	subtitle: 'GALTA — Consultora Informática',
	buttonLink: '/contact',
	buttonText: 'Conversemos tu proyecto',
	text: 'Desarrollamos sitios web, tiendas online y automatizamos procesos con IA para que tu empresa opere de forma más simple y eficiente.'
}
// - FAQ data
const faqData = {
	title: 'Preguntas frecuentes',
	subtitle: 'Todo lo que necesitas saber'
}
// - CTA data
const ctaData = {
	title: 'Hablemos de tu proyecto',
	text: 'Cuéntanos qué necesita tu empresa y te proponemos la mejor solución, desde un sitio web hasta automatizar tus procesos con inteligencia artificial.',
	buttonLink: '/contact',
	buttonText: 'Escríbenos'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<div id="inicio" class="scroll-mt-22 lg:scroll-mt-[6.25rem]">
		<Hero
			title={heroData.title}
			subtitle={heroData.subtitle}
			text={heroData.text}
			buttonLink={heroData.buttonLink}
			buttonText={heroData.buttonText}
		/>
	</div>
	<div id="servicios" class="scroll-mt-22 lg:scroll-mt-[6.25rem]">
		<Features />
	</div>
	<div id="planes" class="scroll-mt-22 lg:scroll-mt-[6.25rem]">
		<Pricing title="Planes y precios" subtitle="Elige el que mejor se ajuste a tu negocio" />
	</div>
	<div id="proceso" class="scroll-mt-22 lg:scroll-mt-[6.25rem]">
		<ScrollSpySteps />
	</div>
	<div id="faq" class="scroll-mt-22 lg:scroll-mt-[6.25rem]">
		<Faq subtitle={faqData.subtitle} title={faqData.title} />
	</div>
	<CTA
		title={ctaData.title}
		text={ctaData.text}
		buttonLink={ctaData.buttonLink}
		buttonText={ctaData.buttonText}
	/>
</Layout>